{
  "name": "@chrischall/booli-mcp",
  "version": "1.2.1",
  "license": "MIT",
  "mcpName": "io.github.chrischall/booli-mcp",
  "description": "Booli.se MCP server for Claude — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/booli-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "booli",
    "real-estate",
    "sweden",
    "property",
    "bostad",
    "slutpriser"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "booli-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.21.0",
    "@fetchproxy/server": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "publishConfig": {
    "access": "public"
  }
}
